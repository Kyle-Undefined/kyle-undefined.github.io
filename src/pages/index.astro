---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GitHubContributionGrid from '../components/GitHubContributionGrid.astro';
import { getCollection } from 'astro:content';

const latestPostLimit = 3;
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
const postsSlice = posts.slice(0, latestPostLimit);

const featuredProjectLimit = 4;
const projects = (await getCollection('projects'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const projectsSlice = projects.slice(0, featuredProjectLimit);
---

  <Layout title="Kyle Undefined | Just a dude who enjoys writing code and learning;">
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "WebSite",
				"name": "Kyle Undefined",
				"url": "https://kyleundefined.dev",
				"description": "Kyle Undefined - self-taught dev writing code, learning new tech, and sharing the journey.",
				"inLanguage": "en"
			},
			{
				"@type": "Person",
				"name": "Kyle Undefined",
				"url": "https://kyleundefined.dev",
				"sameAs": [
					"https://github.com/kyle-undefined"
				],
				"jobTitle": "Software Engineer",
				"knowsAbout": ["TypeScript", "C#", "VB.NET", "ASP.NET Core", "SQL", "Microsoft SQL Server", "Database Design", "Full-Stack Development", "Front-End Development", "Back-End Development", "Software Engineering", "Web Development"]
			}
		]
	})} />
	<section class="py-12 md:py-10">
		<div class="space-y-6">
			<h1 class="text-4xl md:text-6xl font-bold tracking-tighter">
				Heyo, I'm <span class="bg-clip-text text-transparent bg-gradient-to-r from-blog-accent to-blog-code">Kyle</span>...
			</h1>
			<p class="text-xl md:text-2xl text-blog-text">
				Just a dude who enjoys writing code & learning;
			</p>
			<p class="text-xl md:text-2xl text-blog-text">
				I'm a self taught Dev/Eng who started out writing Runescape bots back in highschool. Then in '08 I got my first crack at the industry doing web, but moved to software and back-end, except for a few projects here and there.
			</p>
			<p class="text-xl md:text-2xl text-blog-text">
				I love the craft, there's always some new tech to enjoy, and things are constantly evolving, kind of like myself, which is why I'm <span class="bg-clip-text text-transparent bg-gradient-to-r from-blog-accent to-blog-code">undefined</span>.
			</p>
		</div>
	</section>

	<section class="py-12 border-t border-blog-border">
		<div class="flex items-center justify-between mb-8">
			<h2 class="text-2xl font-bold text-blog-accent">Latest Posts - {postsSlice.length}/{posts.length}</h2>
			{posts.length > latestPostLimit ? (
				<a href="/blog" class="text-blog-link flip-animate">View <span data-hover="all">all</span></a>
			) : null}
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{postsSlice.length > 0 ? (
				postsSlice.map((post) => (
					<PostCard post={post} />
				))
			) : (
				<p class="col-span-full text-center text-slate-500 py-12">No posts found (yet!). Check back soon.</p>
			)}
		</div>
	</section>

	<section class="py-12 border-t border-blog-border">
		<div class="flex items-center justify-between mb-8">
			<h2 class="text-2xl font-bold text-blog-accent">Featured Projects - {projectsSlice.length}/{projects.length}</h2>
			{projects.length > featuredProjectLimit ? (
				<a href="/projects" class="text-blog-link flip-animate">View <span data-hover="all">all</span></a>
			) : null}
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
			{projectsSlice.length > 0 ? (
				projectsSlice.map((project) => (
					<ProjectCard project={project} />
				))
			) : (
				<p class="col-span-full text-center text-slate-500 py-12">No projects found (yet!). Check back soon.</p>
			)}
		</div>
	</section>

	<GitHubContributionGrid username="kyle-undefined" />
  </Layout>
